<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/auth_field_gradient"
    android:fitsSystemWindows="true"
    tools:context=".ui.activities.MenuActivity">

    <!-- Organic leaf decoration top-right (mirrors login) -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:alpha="0.12"
        android:rotation="25"
        android:src="@drawable/ic_leaf_decoration"
        android:layout_gravity="top|end"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-40dp" />

    <!-- Organic leaf decoration bottom-left (mirrors login) -->
    <ImageView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.08"
        android:rotation="-45"
        android:src="@drawable/ic_leaf_decoration"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-60dp"
        android:layout_marginBottom="-60dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOP HEADER: GOV BRANDING + USER WELCOME (same style as login branding bar) -->
        <LinearLayout
