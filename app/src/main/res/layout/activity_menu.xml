<!--                        android:letterSpacing="0.05"-->
<!--                        android:maxLines="1"-->
<!--                        android:ellipsize="end" />-->
<!--                </LinearLayout>-->

<!--                <ImageView-->
<!--                    android:layout_width="18dp"-->
<!--                    android:layout_height="18dp"-->
<!--                    android:src="@drawable/ic_verified_badge"-->
<!--                    app:tint="#A5D6A7" />-->
<!--            </LinearLayout>-->

            <!-- Hero welcome text (mirrors login hero section) -->
            <LinearLayout
                android:id="@+id/hero_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tv_user_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:fontFamily="serif"
                    android:letterSpacing="-0.03"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="back to the field"
                    android:textColor="#C8E6C9"
                    android:textSize="36sp"
                    android:fontFamily="serif"
                    android:letterSpacing="-0.03"
                    android:textStyle="italic"
                    android:paddingEnd="8dp" />

                <!-- Mauza/parcel info pill -->
                <LinearLayout
                    android:id="@+id/ll_selected_abadi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/gov_badge_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:layout_marginTop="10dp"
                    android:visibility="invisible">

                    <TextView
                        android:id="@+id/tv_selected_mauza_caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Parcels: "
                        android:textColor="#E8F5E9"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/tv_selected_abadi_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- MENU CARD (matches login card style) -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:paddingHorizontal="24dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@+id/ll_header"
            app:layout_constraintBottom_toTopOf="@+id/layout_page_footer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="28dp"
                app:cardElevation="24dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <!-- Section label (mirrors "SECURE LOGIN" label) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="2dp"
                            android:background="#2E7D32" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="MAIN MENU"
                            android:textColor="#2E7D32"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.15" />
                    </LinearLayout>

                    <!-- START SURVEY MENU ITEM -->
                    <LinearLayout
                        android:id="@+id/cv_start_survey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/menu_item_bg"
                        android:padding="18dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:foreground="?android:attr/selectableItemBackground">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8F5E9">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="11dp"
                                android:src="@drawable/baseline_add_24"
                                app:tint="#2E7D32"
                                android:scaleType="fitCenter"
                                android:contentDescription="@string/start_survey" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/start_survey"
                                android:textColor="#1B5E20"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.02"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/initiate_ownership_data_collection"
                                android:textColor="#81A881"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_verified_badge"
                            app:tint="#C8E6C9"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <!-- OWNERS LIST MENU ITEM -->
                    <LinearLayout
                        android:id="@+id/cv_property_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/menu_item_bg"
                        android:padding="18dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8F5E9">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="11dp"
                                android:src="@drawable/ic_lines"
                                app:tint="#2E7D32"
                                android:scaleType="fitCenter"
                                android:contentDescription="@string/owners_list" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/owners_list"
                                android:textColor="#1B5E20"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.02"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/view_list_of_owners"
                                android:textColor="#81A881"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_verified_badge"
                            app:tint="#C8E6C9"
                            android:rotation="-90"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <!-- SAVED RECORDS MENU ITEM -->
                    <LinearLayout
                        android:id="@+id/cv_upload_records"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/menu_item_bg"
                        android:padding="18dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:foreground="?android:attr/selectableItemBackground">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8F5E9">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="11dp"
                                android:src="@drawable/baseline_upload_24"
                                app:tint="#2E7D32"
                                android:scaleType="fitCenter"
                                android:contentDescription="@string/saved_records" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/saved_records"
                                android:textColor="#1B5E20"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.02"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/view_and_upload_all_the_saved_records"
                                android:textColor="#81A881"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_verified_badge"
                            app:tint="#C8E6C9"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <!-- DOWNLOAD DATA MENU ITEM -->
                    <LinearLayout
                        android:id="@+id/cv_sync_data"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/menu_item_bg"
                        android:padding="18dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:foreground="?android:attr/selectableItemBackground">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#E8F5E9">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="11dp"
                                android:src="@drawable/baseline_download_24"
                                app:tint="#2E7D32"
                                android:scaleType="fitCenter"
                                android:contentDescription="@string/download_data" />
                        </androidx.cardview.widget.CardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/download_data"
                                android:textColor="#1B5E20"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.02"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/download_the_data_to_start_survey"
                                android:textColor="#81A881"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_verified_badge"
                            app:tint="#C8E6C9"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null" />
                    </LinearLayout>

                    <!-- Decorative tagline (matches login card bottom) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp"
                            android:background="#C8E6C9" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:text="CULTIVATING DIGITAL LAND RECORDS"
                            android:textColor="#81A881"
                            android:textSize="9sp"
                            android:letterSpacing="0.2"
                            android:fontFamily="sans-serif-medium" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="1dp"
                            android:background="#C8E6C9" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </ScrollView>

        <!-- FOOTER (matches login footer style) -->
        <LinearLayout
            android:id="@+id/layout_page_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/government_of_punjab"
                android:scaleType="fitCenter"
                android:alpha="0.6"
                android:src="@drawable/ic_logo_pulse_cropped" />

            <TextView
                android:id="@+id/tv_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="@string/footer_main_menu"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>